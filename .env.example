# ─────────────────────────────────────────────────────────────────────────────
# SentryPay — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for the MCP server (mcp_server/server.py) ──────────────────────
# Elasticsearch Serverless endpoint (full https URL from your Elastic dashboard)
ELASTIC_ENDPOINT=https://your-project.es.us-east-1.aws.elastic.cloud
# API key from the "Get started" page of your Elastic project
ELASTIC_API_KEY=replace-with-your-api-key

# GCP project used for Vertex AI text embeddings (kNN query embedding)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_EMBEDDING_MODEL=text-embedding-004

# ── OPTIONAL — Elastic classic Cloud fallback (only if not using Serverless) ─
# ELASTIC_CLOUD_ID=

# ── OPTIONAL — only needed for the broader SentryPay app, NOT the MCP demo ──
# BigQuery audit logging
# BIGQUERY_DATASET=sentry_pay
# BIGQUERY_TABLE_DECISIONS=decisions

# Langfuse observability
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Gmail OAuth (for the email-monitor agent)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Frontend / API auth
# SENTRY_PAY_API_KEY=sentry-pay-dev-key-2026

# Cloud Run deployment
# CLOUD_RUN_URL=
