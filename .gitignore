venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/

# ── VS Code ──────────────────────────────────────────
.vscode/

# ── Mac ──────────────────────────────────────────────
.DS_Store
